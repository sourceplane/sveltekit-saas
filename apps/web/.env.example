# For `vite dev`: the Supabase project the dev server talks to. A build reads
# these from wrangler.jsonc instead (tooling/wire/with-vars.mjs), and the
# deploy renders that file from the environment's own project — so this file
# is for local work only. Secrets go in .dev.vars (see .dev.vars.example).
PUBLIC_SUPABASE_URL='https://REPLACE_ME.supabase.co'
PUBLIC_SUPABASE_ANON_KEY='REPLACE_ME'
# The site's public origin (sitemap, RSS, emails). Empty: http://localhost:5173
PUBLIC_SITE_URL=''
